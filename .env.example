# ==============================================================================
# Telegram Bot & Google Gemini API Credentials (ЗАМІНІТЬ НА ВЛАСНІ КЛЮЧІ У .env)
# ==============================================================================
BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# AI Models & Grounding
# ==============================================================================
# Модель для відповідей на запитання (/ask, @пінг, аналіз зображень)
GEMINI_ASK_MODEL=gemini-3.8-flash

# Модель для генерації підсумків чату (/summary) та погодинних дайджестів
GEMINI_SUMMARY_MODEL=gemma-4-26b-a4b-it

# Увімкнути Google Search Grounding для /ask (true / false)
GEMINI_ENABLE_SEARCH=true

# ==============================================================================
# Database & Background Scheduler
# ==============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/bot_database.db
DIGEST_INTERVAL_MINUTES=60
RETENTION_DAYS=7

# ==============================================================================
# Anti-Hallucination & Summary Context Settings
# ==============================================================================
SUMMARY_RAW_MESSAGE_LIMIT=400
SUMMARY_RAW_CHAR_LIMIT=60000
SUMMARY_SHOW_CITATIONS=true
SUMMARY_ENABLE_SELF_CHECK=false

# ==============================================================================
# Access Control, Admins & Rate Limiting
# ==============================================================================
# Список дозволених chat_id через кому (порожнє значення = дозволити всі чати)
ALLOWED_CHAT_IDS=

# Список user_id глобальних адміністраторів бота через кому (доступ до /health, /quota та обхід allowlist)
ADMIN_USER_IDS=

# Глобальний ліміт запитів до ШІ за хвилину (0 = без обмежень)
GLOBAL_RPM_LIMIT=30

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO
